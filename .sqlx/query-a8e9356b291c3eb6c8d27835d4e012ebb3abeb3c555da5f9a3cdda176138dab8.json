  "query": "SELECT pi.id AS \"id: PortalIdentityId\", pi.client_id AS \"client_id: ClientId\", pi.email, pi.name, pi.password_hash, pi.status AS \"status: Stored<IdentityStatus>\", pi.source AS \"source: Stored<IdentitySource>\", pi.last_login_at, pi.invited_at, pi.invite_expires_at, pi.created_at, pi.updated_at FROM portal_identities pi WHERE pi.client_id = $1 AND NOT EXISTS (SELECT 1 FROM portal_identity_apps g WHERE g.identity_id = pi.id) ORDER BY pi.created_at, pi.id",
