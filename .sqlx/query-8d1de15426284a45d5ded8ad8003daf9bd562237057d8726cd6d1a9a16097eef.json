  "query": "SELECT DISTINCT p.id, p.type AS \"principal_type: Stored<PrincipalType>\", p.scope AS \"scope: Stored<UserScope>\", p.client_id, p.application_id AS \"application_id: ApplicationId\", p.name, p.active, p.email, p.email_domain, p.idp_type, p.external_idp_id, p.password_hash, p.last_login_at, p.service_account_id, p.all_applications, p.created_at, p.updated_at, p.dev_client_secret_ref, p.dev_client_secret_updated_at FROM iam_principals p\n             LEFT JOIN iam_client_access_grants g ON g.principal_id = p.id\n             WHERE p.active = true AND (p.client_id = $1 OR g.client_id = $1)",
